def processar_pdf(caminho_pdf: Path, data_americana: str):
    try:
        with pdfplumber.open(caminho_pdf) as pdf:
            linhas = pdf.pages[0].extract_text().split("\n")
            nome_completo = extrair_nome_e_codigo(linhas)

        if nome_completo:
            novo_nome = f"{data_americana}_{nome_completo}_Recibo de Pagamento.pdf"
            novo_caminho = caminho_pdf.parent / novo_nome

            if novo_caminho.exists():
                print(f"⚠️ Arquivo já existe: {novo_nome}. Pulei este arquivo.")
                return

            time.sleep(0.1)
            caminho_pdf.rename(novo_caminho)
            print(f"✅ Renomeado: {novo_caminho.name}")
        else:
            print(f"⚠️ Nome do colaborador não encontrado em: {caminho_pdf.name}")

    except PermissionError:
        print(f"❌ O arquivo '{caminho_pdf.name}' está aberto em outro programa. Feche o PDF e tente novamente.")
    except Exception as e:
        print(f"❌ Erro ao processar '{caminho_pdf.name}': {e}")

def main():
    try:
        print("📁 Digite o caminho da pasta ou do arquivo PDF:")
        caminho_input = input(">> ").strip().strip('"')
        caminho_path = Path(caminho_input)

        if not caminho_path.exists():
            print("❌ Caminho não encontrado. Verifique e tente novamente.")
            input("\nPressione Enter para sair...")
            return

        data = input("🗓️ Digite a data no formato americano (AAAA.MM.DD): ").strip()

        if caminho_path.is_file() and caminho_path.suffix.lower() == '.pdf':
            processar_pdf(caminho_path, data)

        elif caminho_path.is_dir():
            pdfs = list(caminho_path.glob("*.pdf"))
            if not pdfs:
                print("⚠️ Nenhum PDF encontrado na pasta.")
            else:
                for pdf in pdfs:
                    processar_pdf(pdf, data)
                    time.sleep(0.2)
        else:
            print("❌ Caminho inválido. Informe um arquivo PDF ou uma pasta contendo PDFs.")

    except Exception as geral:
        print(f"❌ Erro inesperado: {geral}")

    input("\n✅ Processo concluído. Pressione Enter para sair...")

if __name__ == "__main__":
    main()
